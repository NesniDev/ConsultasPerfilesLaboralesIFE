---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import PageHeader from '../components/PageHeader.astro'
import StatsCards from '../components/StatsCards.astro'
import RegistrosCard from '../components/RegistrosCard.astro'
import StudentFormModal from '../components/modals/StudentFormModal.astro'
import StudentDetailModal from '../components/modals/StudentDetailModal.astro'
import ConfirmModal from '../components/modals/ConfirmModal.astro'
import LoginModal from '../components/modals/LoginModal.astro'
import ChangePasswordModal from '../components/modals/ChangePasswordModal.astro'
import ToastContainer from '../components/ToastContainer.astro'
import '../styles/dashboard.css'
---

<Layout title="IFE · Panel de Perfiles Laborales">
  <div class="app-shell">
    <PageHeader />

    <main class="page-content">
      <div id="admin-stats" style="display: none;">
        <StatsCards />
      </div>
      <RegistrosCard />
    </main>

    <footer class="app-footer">
      <p>Consultas Perfiles Laborales IFE v1.0</p>
    </footer>
  </div>

  <StudentFormModal />
  <StudentDetailModal />
  <ConfirmModal />
  <LoginModal />
  <ChangePasswordModal />
  <ToastContainer />

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline>
    // Initialize Supabase Auth
    window.initSupabaseAuth = function() {
      const SUPABASE_URL = "https://zjjcsmcojstgpfnircnb.supabase.co";
      const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpqamNvanN0Z3BmbmlyY25iIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwNDY1MTQsImV4cCI6MjEwMTYyMjUxNH0.LFmh7EQQViqaoaKgZ7eqY79eXAKoDNhzUWVE9YBYv6Y";

      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        console.error('Missing Supabase credentials');
        console.error('SUPABASE_URL:', SUPABASE_URL);
        console.error('SUPABASE_ANON_KEY:', SUPABASE_ANON_KEY);
        alert('Error: Supabase credentials not configured. Check .env file.');
        return false;
      }

      if (typeof supabase === 'undefined') {
        console.error('Supabase library not loaded from CDN');
        return false;
      }

      window.supabaseAuth = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY).auth;
      console.log('✓ Supabase Auth initialized successfully');
      return true;
    };

    // Initialize when page loads
    if (typeof supabase !== 'undefined') {
      window.initSupabaseAuth();
    } else {
      window.addEventListener('load', () => {
        setTimeout(() => window.initSupabaseAuth(), 500);
      });
    }
  </script>
  <script is:inline src="/scripts/api.js"></script>
  <script is:inline src="/scripts/store.js"></script>
  <script is:inline src="/scripts/app.js"></script>
</Layout>
