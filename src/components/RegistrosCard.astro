---
import FiltersBar from './FiltersBar.astro';
import StudentTable from './StudentTable.astro';
import TablePagination from './TablePagination.astro';
---

<section class="content-card" id="registros">
  <div class="card-header">
    <div class="card-header-left">
      <h2 class="card-title">Registro de Estudiantes</h2>
      <p class="card-description">Información de los perfiles laborales</p>
    </div>
    <div class="card-header-right" id="admin-controls">
      <button class="btn btn-secondary btn-sm" onclick="app.clearFilters()">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
        </svg>
        Limpiar
      </button>
      <button class="btn btn-primary" onclick="app.openCreateForm()">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo Registro
      </button>
    </div>
  </div>

  <FiltersBar />
  <StudentTable />
  <TablePagination />
</section>
