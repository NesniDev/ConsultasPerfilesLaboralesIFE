          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="login-form" onsubmit="app.handleLogin(event)" class="login-form">
      <div class="login-field">
        <label class="login-label">Usuario</label>
        <input type="text" class="login-input" id="login-username" placeholder="Ingresa tu usuario" required />
      </div>

      <div class="login-field">
        <label class="login-label">Contraseña</label>
        <div class="login-password-wrapper">
          <input type="password" class="login-input" id="login-password" placeholder="Ingresa tu contraseña" required />
          <button
            type="button"
            class="login-eye-btn"
            onclick="app.togglePasswordVisibility()"
          >
            <svg id="password-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
