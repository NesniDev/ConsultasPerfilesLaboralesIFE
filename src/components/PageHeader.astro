---
interface Props {
  eyebrow?: string
  title?: string
  subtitle?: string
}

const {
  eyebrow = 'IFE',
  title = 'Estudiantes en Práctica',
  subtitle = 'Directorio de perfiles laborales'
} = Astro.props
---

<header class="page-header">
  <div class="page-header-content">
    <div class="page-header-brand">
      <img src="/LOGO-IFE.png" alt="Logo IFE" class="page-header-logo" />
    </div>
    <div class="page-header-actions">
      <div id="admin-badge" style="display: none; gap: 12px; align-items: center;">
        <span style="font-size: 12px; padding: 4px 8px; background: #3b82f6; color: white; border-radius: 4px;">
          Administrador
        </span>
        <button onclick="app.logout()" style="background: none; border: none; color: #666; cursor: pointer; font-size: 14px; padding: 0;">
          Cerrar sesión
        </button>
      </div>
      <div class="page-header-buttons">
        <button class="header-btn" onclick="app.goToLogin()" id="login-btn">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
            ></path>
          </svg>
          Iniciar Sesión
        </button>
      </div>
    </div>
  </div>
</header>
