---
const navItems = [
  {
    label: 'Dashboard',
    href: '#',
    active: true,
    action: false,
    onclick: 'app.closeMobileNav()',
    icon: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25',
  },
  {
    label: 'Registros',
    href: '#registros',
    active: false,
    action: false,
    onclick: 'app.closeMobileNav()',
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  },
  {
    label: 'Exportar CSV',
    href: '#',
    active: false,
    action: true,
    onclick: 'app.exportCSV(); app.closeMobileNav(); return false;',
    icon: 'M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3',
  },
  {
    label: 'Actualizar',
    href: '#',
    active: false,
    action: true,
    onclick: 'location.reload(); return false;',
    icon: 'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182',
  },
];
---

<header class="navbar">
  <div class="navbar-inner">
    <div class="navbar-brand">
      <img src="/LOGO-IFE.png" alt="Logo IFE" class="navbar-logo" />
      <div class="navbar-brand-text">
        <span class="navbar-brand-name">IFE Panel</span>
        <span>Perfiles Laborales</span>
      </div>
    </div>

    <nav class="navbar-links" id="navbar-links">
      {
        navItems.map((item) => (
          <a
            class:list={['nav-item', item.active && 'active', item.action && 'nav-item-action']}
            href={item.href}
            onclick={item.onclick}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <button class="menu-toggle" aria-label="Abrir menú" onclick="app.toggleMobileNav()">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>
</header>
