---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import PageHeader from '../components/PageHeader.astro'
import StatsCards from '../components/StatsCards.astro'
import RegistrosCard from '../components/RegistrosCard.astro'
import StudentFormModal from '../components/modals/StudentFormModal.astro'
import StudentDetailModal from '../components/modals/StudentDetailModal.astro'
import ConfirmModal from '../components/modals/ConfirmModal.astro'
import LoginModal from '../components/modals/LoginModal.astro'
import ChangePasswordModal from '../components/modals/ChangePasswordModal.astro'
import ToastContainer from '../components/ToastContainer.astro'
import '../styles/dashboard.css'
---

<Layout title="IFE · Panel de Perfiles Laborales">
  <div class="app-shell">
    <PageHeader />

    <main class="page-content">
      <div id="admin-stats" style="display: none;">
        <StatsCards />
      </div>
      <RegistrosCard />
    </main>

    <footer class="app-footer">
      <p>Consultas Perfiles Laborales IFE v1.0</p>
    </footer>
  </div>

  <StudentFormModal />
  <StudentDetailModal />
  <ConfirmModal />
  <LoginModal />
  <ChangePasswordModal />
  <ToastContainer />

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0"></script>
  <script is:inline>
    // Initialize Supabase Auth with retry logic
    window.initSupabaseAuth = function() {
      const SUPABASE_URL = "https://zjjcsmcojstgpfnircnb.supabase.co";
      const SUPABASE_ANON_KEY = "sb_publishable_AKRj6rZCTZ1-_Pe9GUjEDA_z4RQcDc0";

      if (typeof window.supabase === 'undefined') {
        console.warn('Supabase library still loading...');
        return false;
      }

      try {
        const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        window.supabaseAuth = client.auth;
        console.log('✓ Supabase Auth initialized');
        return true;
      } catch (err) {
        console.error('Failed to initialize Supabase:', err);
        return false;
      }
    };

    // Retry initialization with exponential backoff
    let retries = 0;
    const maxRetries = 10;

    function tryInit() {
      if (window.initSupabaseAuth()) {
        return; // Success
      }

      retries++;
      if (retries < maxRetries) {
        setTimeout(tryInit, 100 * retries);
      } else {
        console.error('Failed to initialize Supabase after retries');
      }
    }

    // Start initialization
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', tryInit);
    } else {
      tryInit();
    }
  </script>
  <script is:inline src="/scripts/api.js"></script>
  <script is:inline src="/scripts/store.js"></script>
  <script is:inline src="/scripts/app.js"></script>
</Layout>
