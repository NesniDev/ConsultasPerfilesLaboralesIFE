---
interface Props {
  eyebrow?: string
  title?: string
  subtitle?: string
}

const {
  eyebrow = 'Bienvenido',
  title = 'Registros de Estudiantes',
  subtitle = 'Consulta los perfiles laborales de nuestros estudiantes en práctica'
} = Astro.props
---

<header class="page-header">
  <div class="page-header-content">
    <div class="page-header-brand">
      <img src="/LOGO-IFE.png" alt="Logo IFE" class="page-header-logo" />
      <div class="page-header-text">
        <span class="page-header-eyebrow">{eyebrow}</span>
        <h1 class="page-header-title">{title}</h1>
        <p class="page-header-subtitle">{subtitle}</p>
      </div>
    </div>
    <div class="page-header-actions">
      <div class="page-header-buttons">
        <button class="header-btn" onclick="app.goToLogin()" id="login-btn">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
            ></path>
          </svg>
          Iniciar Sesión
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .page-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .page-header::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 500px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    transform: translate(150px, -150px);
  }

  .page-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 50%;
    transform: translate(-100px, 100px);
  }

  .page-header-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
  }

  .page-header-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .page-header-logo {
    width: 60px;
    height: 60px;
  }

  .page-header-text {
    display: flex;
    flex-direction: column;
  }

  .page-header-eyebrow {
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .page-header-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0.5rem 0 0;
    letter-spacing: -0.02em;
  }

  .page-header-subtitle {
    font-size: 0.95rem;
    opacity: 0.85;
    margin: 0.25rem 0 0;
    font-weight: 300;
  }

  .page-header-actions {
    display: flex;
    gap: 1rem;
  }

  .page-header-buttons {
    display: flex;
    gap: 1rem;
  }

  .header-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.95);
    color: #667eea;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
  }

  .header-btn:hover {
    background: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .header-btn svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 2rem 1rem;
    }

    .page-header-content {
      flex-direction: column;
      gap: 2rem;
      text-align: center;
    }

    .page-header-title {
      font-size: 1.5rem;
    }

    .page-header-actions {
      width: 100%;
      justify-content: center;
    }
  }
</style>
